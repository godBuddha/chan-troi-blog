# ============================================================
#  Chỉ 3 biến này là CẦN THIẾT lúc đầu. Mọi thiết lập còn lại
#  (tên blog, video hero, AI key, bản đồ...) đều chỉnh trong
#  trang quản trị /admin — không nằm trong file này.
# ============================================================

# Mật khẩu PostgreSQL — tự sinh một chuỗi ngẫu nhiên rồi dán vào đây
POSTGRES_PASSWORD=doi-mat-khau-nay

# Chuỗi kết nối DB (dùng mật khẩu phía trên)
DATABASE_URI=postgres://blog:doi-mat-khau-nay@postgres:5432/blog

# Secret của Payload (bất kỳ chuỗi ngẫu nhiên dài 32+ ký tự)
PAYLOAD_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# --- Tên miền & HTTPS (tuỳ chọn) ---
# Có tên miền: điền vào 2 dòng dưới (Caddy tự cấp HTTPS)
# SITE_DOMAIN=blog.example.com
# ACME_EMAIL=ban@example.com
# Chưa có: bỏ trống, truy cập qua http://localhost

# --- Bản đồ tự host (tuỳ chọn) ---
# Nạp file .mbtiles vào ./data/tiles/ rồi đặt tên file ở đây,
# sau đó bật service tiles: docker compose --profile map up -d
# TILES_FILE=map.mbtiles
