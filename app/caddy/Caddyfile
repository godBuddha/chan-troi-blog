# Một block duy nhất:
#  - .env không đặt SITE_DOMAIN  → chạy ở http://localhost
#  - .env đặt SITE_DOMAIN=blog.example.com → Caddy tự cấp/gia hạn HTTPS cho domain đó
{$SITE_DOMAIN:localhost} {
	# Bản đồ tự host (service "tiles", bật bằng --profile map):
	# admin → Thiết lập website → Bản đồ, điền: https://ten-mien/tiles/styles/osm-bright/style.json
	handle_path /tiles/* {
		reverse_proxy tiles:8080
	}
	reverse_proxy web:3000
}
