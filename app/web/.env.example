# Mẫu file .env cho app/web — chỉ cần khi chạy dev trực tiếp ngoài Docker
# (npm run dev). Khi chạy bằng docker compose, các biến này lấy từ app/.env.

# Chuỗi kết nối PostgreSQL (mật khẩu phải khớp POSTGRES_PASSWORD trong app/.env)
DATABASE_URI=postgres://blog:mat-khau@127.0.0.1:5432/blog

# Secret của Payload (chuỗi ngẫu nhiên dài 32+ ký tự)
PAYLOAD_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# Thư mục chứa ảnh/video khi dev (production dùng volume media)
MEDIA_DIR=./media-dev
